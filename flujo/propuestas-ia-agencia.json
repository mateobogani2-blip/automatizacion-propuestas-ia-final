          "mode": "list",
          "cachedResultName": "claude-haiku-5-5"
        },
        "messages": {
          "values": [
            {
              "content": "=Sos el asistente comercial de una agencia de marketing digital.\nAnalizá la consulta de este cliente y devolvé SOLO un JSON válido, sin texto extra ni backticks, con estas claves:\n- \"servicio\": uno de \"SEO\", \"Redes\", \"Ads\", \"Web\"\n- \"presupuesto\": número estimado en USD (0 si no se menciona)\n- \"plazo\": texto breve\n- \"borrador\": propuesta comercial de máximo 150 palabras, tono cordial, dirigida al cliente\n\nCliente: {{ $('Recibir Consulta').item.json.body.nombre }} ({{ $('Recibir Consulta').item.json.body.empresa }})\nConsulta: {{ $('Recibir Consulta').item.json.body.mensaje }}\nFirmá siempre como \"Equipo Comercial\" de la agencia. No uses corchetes ni campos entre [ ] como [Nombre]: el texto debe estar listo para enviar."
            }
          ]
        },
        "options": {
          "maxTokens": 2500
        }
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        256,
        -208
      ],
      "id": "7e49247b-8de3-47b3-b00b-f91ce1168dc3",
      "name": "Claude redacta propuesta",
      "credentials": {
        "anthropicApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bloques = $input.item.json.content || [];\nconst bloque = bloques.find(b => b.type === 'text');\n\nif (!bloque) {\n  throw new Error('La IA no devolvió texto. Revisar max tokens o thinking.');\n}\n\nconst limpio = bloque.text.replace(/```json|```/g, '').trim();\nconst data = JSON.parse(limpio);\n\nreturn {\n  json: {\n    servicio: data.servicio,\n    presupuesto: Number(data.presupuesto) || 0,\n    plazo: data.plazo,\n    borrador: data.borrador\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
